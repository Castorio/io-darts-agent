          "label": "Tiempo de Transición (ms)",
          "description": "Tiempo de transición global en milisegundos. Vacío = valor de WLED, 0 = instantáneo"
        },
        "cricketMarksThreshold": {
          "label": "Gran turno desde marcas",
          "description": "Número de marcas en un turno de Cricket a partir del cual se activa el efecto de gran turno"
        }
      },
      "strings": {
        "connectionSuccess": "¡Conectado exitosamente a WLED!",
        "connectionFailed": "Error al conectar con WLED",
        "testConnection": "Probar Conexión",
        "eventActions": "Acciones de Eventos",
        "playerColors": "Colores de Jugadores"
      }
    }
  }
}
