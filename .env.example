# IO-Darts-Agent Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Autodarts OAuth client (optional)
# ===================
# The hub logs in via https://api.autodarts.com/auth/v1 with the client id
# of the Autodarts web app (autodarts-play). Override only if Autodarts
# issued a client id for you. A client secret is no longer used.
# AUTODARTS_CLIENT_ID=autodarts-play

# ===================
# User Credentials (for testing only)
# ===================
# These can also be set via the web UI
# AUTODARTS_EMAIL=your-email@example.com
# AUTODARTS_PASSWORD=your-password
# AUTODARTS_BOARD_ID=your-board-id

# ===================
# Server Settings (optional)
# ===================
# SERVER_PORT=3000
# SERVER_HOST=0.0.0.0
