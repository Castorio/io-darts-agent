{
  "id": "game-display",
  "name": "Game Display",
  "version": "1.4.0",
  "description": "Displays the current game score on a separate display. Perfect for large screens next to the dartboard.",
  "author": "IO-Darts-Agent Team",
  "entry": "internal",
  "events": [
    "match.start",
    "match.delete",
    "match.finished",
    "match.state",
    "throw.detected",
    "player.change",
    "turn.finished",
    "game.finished"
  ],
  "config": {
    "displayName": {
      "type": "string",
      "label": "Display Name",
      "description": "Name of this display (for multiple displays)",
      "default": "Main Display"
    },
    "idleMode": {
      "type": "select",
      "label": "Idle Mode",
      "description": "What to show when no game is active",
      "default": "lastGame",
      "options": [
        { "value": "black", "label": "Black Screen" },
        { "value": "image", "label": "Custom Image" },
        { "value": "lastGame", "label": "Show Last Game Score" }
      ]
    },
    "idleImageUrl": {
      "type": "string",
      "label": "Idle Image URL",
      "description": "URL to the image shown in idle mode (only for 'Custom Image')",
      "default": "",
      "showIf": { "field": "idleMode", "value": "image" }
    },
    "showCheckouts": {
      "type": "boolean",
      "label": "Show Checkout Suggestions",
      "description": "Shows possible checkout paths",
      "default": true
    },
    "checkoutThreshold": {
      "type": "number",
      "label": "Checkout From Score",
      "description": "From which score checkout suggestions are shown",
      "default": 170,
      "min": 2,
      "max": 170
    },
    "showOtherPlayers": {
      "type": "boolean",
      "label": "Show Other Players",
      "description": "Shows other players at the bottom",
      "default": true
    },
    "animationsEnabled": {
      "type": "boolean",
      "label": "Enable Animations",
      "description": "Show animations for special events (180, bulls, wins)",
      "default": true
    },
    "defaultAnimationDuration": {
      "type": "number",
      "label": "Default Animation Duration (ms)",
      "description": "Default display duration for animations",
      "default": 3000,
      "min": 500,
      "max": 10000
    },
    "animation180": {
      "type": "group",
      "label": "180 Animation",
      "description": "Animation for 180 scores",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "description": "URL to GIF or video",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "description": "URL to sound file (MP3, WAV)",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 4000,
          "min": 1000,
          "max": 10000
        }
      }
    },
    "animationBull": {
      "type": "group",
      "label": "Bull Animation",
      "description": "Animation for single bulls (25)",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 2000,
          "min": 500,
          "max": 5000
        }
      }
    },
    "animationDoubleBull": {
      "type": "group",
      "label": "Double Bull Animation",
      "description": "Animation for double bulls (50)",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 2500,
          "min": 500,
          "max": 5000
        }
      }
    },
    "animationHighScore": {
      "type": "group",
      "label": "High Score Animation",
      "description": "Animation for high scores",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "threshold": {
          "type": "number",
          "label": "From Score",
          "default": 140,
          "min": 100,
          "max": 179
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 2000,
          "min": 500,
          "max": 5000
        }
      }
    },
    "animationCheckout": {
      "type": "group",
      "label": "Checkout Animation",
      "description": "Animation for successful checkouts",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 2500,
          "min": 1000,
          "max": 5000
        }
      }
    },
    "animationLegWin": {
      "type": "group",
      "label": "Leg Win Animation",
      "description": "Animation when winning a leg",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 3000,
          "min": 1000,
          "max": 8000
        }
      }
    },
    "animationMatchWin": {
      "type": "group",
      "label": "Match Win Animation",
      "description": "Animation when winning the match",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 5000,
          "min": 2000,
          "max": 15000
        }
      }
    },
    "animationBust": {
      "type": "group",
      "label": "Bust Animation",
      "description": "Animation when player busts",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 1500,
          "min": 500,
          "max": 3000
        }
      }
    }
  },
