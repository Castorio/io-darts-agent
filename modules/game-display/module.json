{
  "id": "game-display",
  "name": "Game Display",
  "version": "1.3.0",
  "description": "Displays the current game score on a separate display. Perfect for large screens next to the dartboard.",
  "author": "IO-Darts-Agent Team",
  "entry": "internal",
  "events": [
    "match.start",
    "match.delete",
    "match.finished",
    "match.state",
    "throw.detected",
    "player.change",
    "turn.finished",
    "game.finished"
  ],
  "config": {
    "displayName": {
      "type": "string",
      "label": "Display Name",
      "description": "Name of this display (for multiple displays)",
      "default": "Main Display"
    },
    "idleMode": {
      "type": "select",
      "label": "Idle Mode",
      "description": "What to show when no game is active",
      "default": "lastGame",
      "options": [
        { "value": "black", "label": "Black Screen" },
        { "value": "image", "label": "Custom Image" },
        { "value": "lastGame", "label": "Show Last Game Score" }
      ]
    },
    "idleImageUrl": {
      "type": "string",
      "label": "Idle Image URL",
      "description": "URL to the image shown in idle mode (only for 'Custom Image')",
      "default": ""
    },
    "showCheckouts": {
      "type": "boolean",
      "label": "Show Checkout Suggestions",
      "description": "Shows possible checkout paths",
      "default": true
    },
    "checkoutThreshold": {
      "type": "number",
      "label": "Checkout From Score",
      "description": "From which score checkout suggestions are shown",
      "default": 170,
      "min": 2,
      "max": 170
    },
    "animationSpeed": {
      "type": "select",
      "label": "Animation Speed",
      "description": "Speed of animations",
      "default": "normal",
      "options": [
        { "value": "slow", "label": "Slow" },
        { "value": "normal", "label": "Normal" },
        { "value": "fast", "label": "Fast" }
      ]
    },
    "showOtherPlayers": {
      "type": "boolean",
      "label": "Show Other Players",
      "description": "Shows other players at the bottom",
      "default": true
    },
    "animations": {
      "type": "group",
      "label": "Animations",
      "description": "Configure animations for special events",
      "fields": {
        "enabled": {
          "type": "boolean",
          "label": "Enable Animations",
          "description": "Global switch for all event animations",
          "default": true
        },
        "duration": {
          "type": "number",
          "label": "Animation Duration (ms)",
          "description": "Default display duration for animations",
          "default": 3000,
          "min": 500,
          "max": 10000
        },
        "throw180": {
          "type": "object",
          "label": "180 Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Enabled",
              "default": true
            },
            "type": {
              "type": "select",
              "label": "Animation Type",
              "default": "builtin",
              "options": [
                { "value": "builtin", "label": "Built-in" },
                { "value": "gif", "label": "GIF" },
                { "value": "video", "label": "Video" }
              ]
            },
            "url": {
              "type": "string",
              "label": "Media URL",
              "description": "URL to GIF or video (only for GIF/Video type)",
              "default": ""
            },
            "sound": {
              "type": "boolean",
              "label": "Play Sound",
              "default": true
            },
            "soundUrl": {
              "type": "string",
              "label": "Sound URL",
              "description": "URL to sound file (MP3, WAV)",
              "default": ""
            },
            "duration": {
              "type": "number",
              "label": "Duration (ms)",
              "default": 4000,
              "min": 1000,
              "max": 10000
            }
          }
        },
        "bull": {
          "type": "object",
          "label": "Bull Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Enabled",
              "default": true
            },
            "type": {
              "type": "select",
              "label": "Animation Type",
              "default": "builtin",
              "options": [
                { "value": "builtin", "label": "Built-in" },
                { "value": "gif", "label": "GIF" },
                { "value": "video", "label": "Video" }
              ]
            },
            "url": {
              "type": "string",
              "label": "Media URL",
              "default": ""
            },
            "sound": {
              "type": "boolean",
              "label": "Play Sound",
              "default": true
            },
            "soundUrl": {
              "type": "string",
              "label": "Sound URL",
              "default": ""
            },
            "duration": {
              "type": "number",
              "label": "Duration (ms)",
              "default": 2000,
              "min": 500,
              "max": 5000
            }
          }
        },
        "doubleBull": {
          "type": "object",
          "label": "Double Bull Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Enabled",
              "default": true
            },
            "type": {
              "type": "select",
              "label": "Animation Type",
              "default": "builtin",
              "options": [
                { "value": "builtin", "label": "Built-in" },
                { "value": "gif", "label": "GIF" },
                { "value": "video", "label": "Video" }
              ]
            },
            "url": {
              "type": "string",
              "label": "Media URL",
              "default": ""
            },
            "sound": {
              "type": "boolean",
              "label": "Play Sound",
              "default": true
            },
            "soundUrl": {
              "type": "string",
              "label": "Sound URL",
              "default": ""
            },
            "duration": {
              "type": "number",
              "label": "Duration (ms)",
              "default": 2500,
              "min": 500,
              "max": 5000
            }
          }
        },
        "legWin": {
          "type": "object",
          "label": "Leg Win Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Enabled",
              "default": true
            },
            "type": {
              "type": "select",
              "label": "Animation Type",
              "default": "builtin",
              "options": [
                { "value": "builtin", "label": "Built-in" },
                { "value": "gif", "label": "GIF" },
                { "value": "video", "label": "Video" }
              ]
            },
            "url": {
              "type": "string",
              "label": "Media URL",
              "default": ""
            },
            "sound": {
              "type": "boolean",
              "label": "Play Sound",
              "default": true
            },
            "soundUrl": {
              "type": "string",
              "label": "Sound URL",
              "default": ""
            },
            "duration": {
              "type": "number",
              "label": "Duration (ms)",
              "default": 3000,
              "min": 1000,
              "max": 8000
            }
          }
        },
        "matchWin": {
          "type": "object",
          "label": "Match Win Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Enabled",
              "default": true
            },
            "type": {
              "type": "select",
              "label": "Animation Type",
              "default": "builtin",
              "options": [
                { "value": "builtin", "label": "Built-in" },
                { "value": "gif", "label": "GIF" },
                { "value": "video", "label": "Video" }
              ]
            },
            "url": {
              "type": "string",
              "label": "Media URL",
              "default": ""
            },
            "sound": {
              "type": "boolean",
              "label": "Play Sound",
              "default": true
            },
            "soundUrl": {
              "type": "string",
              "label": "Sound URL",
              "default": ""
            },
            "duration": {
              "type": "number",
              "label": "Duration (ms)",
              "default": 5000,
              "min": 2000,
              "max": 15000
            }
          }
        },
        "highScore": {
          "type": "object",
          "label": "High Score Animation (140+)",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Enabled",
              "default": true
            },
            "threshold": {
              "type": "number",
              "label": "From Score",
              "default": 140,
              "min": 100,
              "max": 179
            },
            "type": {
              "type": "select",
              "label": "Animation Type",
              "default": "builtin",
              "options": [
                { "value": "builtin", "label": "Built-in" },
                { "value": "gif", "label": "GIF" },
                { "value": "video", "label": "Video" }
              ]
            },
            "url": {
              "type": "string",
              "label": "Media URL",
              "default": ""
            },
            "sound": {
              "type": "boolean",
              "label": "Play Sound",
              "default": false
            },
            "soundUrl": {
              "type": "string",
              "label": "Sound URL",
              "default": ""
            },
            "duration": {
              "type": "number",
              "label": "Duration (ms)",
              "default": 2000,
              "min": 500,
              "max": 5000
            }
          }
        },
        "checkout": {
          "type": "object",
          "label": "Checkout Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Enabled",
              "default": true
            },
            "type": {
              "type": "select",
              "label": "Animation Type",
              "default": "builtin",
              "options": [
                { "value": "builtin", "label": "Built-in" },
                { "value": "gif", "label": "GIF" },
                { "value": "video", "label": "Video" }
              ]
            },
            "url": {
              "type": "string",
              "label": "Media URL",
              "default": ""
            },
            "sound": {
              "type": "boolean",
              "label": "Play Sound",
              "default": true
            },
            "soundUrl": {
              "type": "string",
              "label": "Sound URL",
              "default": ""
            },
            "duration": {
              "type": "number",
              "label": "Duration (ms)",
              "default": 2500,
              "min": 1000,
              "max": 5000
            }
          }
        },
        "bust": {
          "type": "object",
          "label": "Bust Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Enabled",
              "default": true
            },
            "type": {
              "type": "select",
