{
  "id": "wled",
  "name": "WLED Lighting Controller",
  "version": "1.3.0",
  "description": "Controls WLED-based LED strips based on Autodarts game events. Flash colors on throws, show player colors, celebrate 180s, and more!",
  "author": "IO-Darts-Agent Team",
  "repository": "https://github.com/autodarts/autodarts-wled-module",
  "entry": "dist/index.js",
  "events": [
    "match.started",
    "match.finished",
    "match.finish",
    "match.deleted",
    "throw.detected",
    "throw.triple",
    "throw.double",
    "throw.bull",
    "throw.bullseye",
    "throw.180",
    "throw.miss",
    "player.changed",
    "turn.started",
    "turn.finished",
    "takeout.started",
    "takeout.finished",
    "game.finished",
    "cricket.closed"
  ],
  "eventMeta": {
    "match.started": {
      "label": { "de": "Match gestartet", "en": "Match started", "es": "Partido iniciado" },
      "description": { "de": "Wird ausgelöst wenn ein neues Match beginnt", "en": "Triggered when a new match starts", "es": "Se activa cuando comienza un nuevo partido" }
    },
    "match.finished": {
      "label": { "de": "Match beendet", "en": "Match finished", "es": "Partido terminado" },
      "description": { "de": "Wird ausgelöst wenn ein Match zu Ende ist", "en": "Triggered when a match ends", "es": "Se activa cuando termina un partido" }
    },
    "match.finish": {
      "label": { "de": "Match verlassen", "en": "Match left", "es": "Partido abandonado" },
      "description": { "de": "Benutzer klickt auf Beenden (nach der Ergebnisanzeige)", "en": "User clicks finish (after results screen)", "es": "El usuario hace clic en finalizar" }
    },
    "match.deleted": {
      "label": { "de": "Match abgebrochen", "en": "Match cancelled", "es": "Partido cancelado" },
      "description": { "de": "Match wurde abgebrochen", "en": "Match was cancelled", "es": "El partido fue cancelado" }
    },
    "throw.detected": {
      "label": { "de": "Wurf erkannt", "en": "Throw detected", "es": "Tiro detectado" },
      "description": { "de": "Ein normaler Wurf wurde erkannt", "en": "A normal throw was detected", "es": "Se detectó un tiro normal" }
    },
    "throw.triple": {
      "label": { "de": "Triple getroffen", "en": "Triple hit", "es": "Triple golpeado" },
      "description": { "de": "Ein Triple-Feld wurde getroffen", "en": "A triple field was hit", "es": "Se golpeó un campo triple" }
    },
    "throw.double": {
      "label": { "de": "Double getroffen", "en": "Double hit", "es": "Doble golpeado" },
      "description": { "de": "Ein Double-Feld wurde getroffen", "en": "A double field was hit", "es": "Se golpeó un campo doble" }
    },
    "throw.bull": {
      "label": { "de": "Single Bull", "en": "Single Bull", "es": "Bull simple" },
      "description": { "de": "Das äußere Bull wurde getroffen (25)", "en": "The outer bull was hit (25)", "es": "Se golpeó el bull exterior (25)" }
    },
    "throw.bullseye": {
      "label": { "de": "Bullseye!", "en": "Bullseye!", "es": "¡Bullseye!" },
      "description": { "de": "Das Bullseye wurde getroffen (50)", "en": "The bullseye was hit (50)", "es": "Se golpeó el bullseye (50)" }
    },
    "throw.180": {
      "label": { "de": "180!", "en": "180!", "es": "¡180!" },
      "description": { "de": "Eine perfekte 180 wurde geworfen", "en": "A perfect 180 was thrown", "es": "Se lanzó un 180 perfecto" }
    },
    "throw.miss": {
      "label": { "de": "Fehlwurf", "en": "Miss", "es": "Fallo" },
      "description": { "de": "Die Scheibe wurde verfehlt", "en": "The board was missed", "es": "Se falló el tablero" }
    },
    "player.changed": {
      "label": { "de": "Spielerwechsel", "en": "Player changed", "es": "Cambio de jugador" },
      "description": { "de": "Der aktive Spieler hat gewechselt", "en": "The active player has changed", "es": "El jugador activo ha cambiado" }
    },
    "turn.started": {
      "label": { "de": "Aufnahme gestartet", "en": "Turn started", "es": "Turno iniciado" },
      "description": { "de": "Ein Spieler beginnt seine Aufnahme", "en": "A player starts their turn", "es": "Un jugador comienza su turno" }
    },
    "turn.finished": {
      "label": { "de": "Aufnahme beendet", "en": "Turn finished", "es": "Turno terminado" },
      "description": { "de": "Ein Spieler beendet seine Aufnahme", "en": "A player finishes their turn", "es": "Un jugador termina su turno" }
    },
    "takeout.started": {
      "label": { "de": "Pfeile ziehen", "en": "Pulling darts", "es": "Sacando dardos" },
      "description": { "de": "Die Pfeile werden aus der Scheibe gezogen", "en": "Darts are being pulled from the board", "es": "Los dardos se están sacando del tablero" }
    },
    "takeout.finished": {
      "label": { "de": "Pfeile gezogen", "en": "Darts pulled", "es": "Dardos sacados" },
      "description": { "de": "Die Pfeile wurden aus der Scheibe gezogen", "en": "Darts have been pulled from the board", "es": "Los dardos han sido sacados del tablero" }
    },
    "game.finished": {
      "label": { "de": "Leg beendet", "en": "Leg finished", "es": "Leg terminado" },
      "description": { "de": "Ein Leg wurde beendet", "en": "A leg has been finished", "es": "Se ha terminado un leg" }
    },
    "cricket.closed": {
      "label": { "de": "Cricket: Feld geschlossen", "en": "Cricket: field closed", "es": "Cricket: campo cerrado" },
      "description": { "de": "Ein Spieler schließt ein Feld mit dem dritten Treffer", "en": "A player closes a field with the third mark", "es": "Un jugador cierra un campo con la tercera marca" }
    },
    "cricket.marks": {
      "label": { "de": "Cricket: Starke Aufnahme", "en": "Cricket: strong turn", "es": "Cricket: gran turno" },
      "description": { "de": "Aufnahme ab der eingestellten Zahl Marks (Standard 6)", "en": "Turn from the set number of marks (default 6)", "es": "Turno desde el número de marcas configurado (6 por defecto)" }
    }
  },
  "eventGroups": [
    {
      "title": { "de": "Match Events", "en": "Match Events", "es": "Eventos de Partido" },
      "events": ["match.started", "match.finished", "match.finish", "match.deleted"]
    },
    {
      "title": { "de": "Wurf Events", "en": "Throw Events", "es": "Eventos de Tiro" },
      "events": ["throw.detected", "throw.triple", "throw.double", "throw.bull", "throw.bullseye", "throw.180", "throw.miss"]
    },
    {
      "title": { "de": "Spieler Events", "en": "Player Events", "es": "Eventos de Jugador" },
      "events": ["player.changed", "turn.started", "turn.finished"]
    },
    {
      "title": { "de": "Board Events", "en": "Board Events", "es": "Eventos del Tablero" },
      "events": ["takeout.started", "takeout.finished"]
    },
    {
      "title": { "de": "Cricket", "en": "Cricket", "es": "Cricket" },
      "events": ["cricket.closed", "cricket.marks"]
    }
  ],
  "config": {
    "wledHost": {
      "type": "string",
      "label": "WLED IP Address",
      "description": "The IP address or hostname of the WLED controller",
      "required": true,
      "default": ""
    },
    "wledPort": {
      "type": "number",
      "label": "WLED Port",
      "description": "HTTP port of the WLED controller",
      "default": 80,
      "min": 1,
      "max": 65535
    },
    "fadeTime": {
      "type": "number",
      "label": "Fade Time (ms)",
      "description": "Global transition time in milliseconds for fading between light states. Empty = WLED default, 0 = instant",
      "min": 0,
      "max": 10000,
      "step": 100
    },
    "cricketMarksThreshold": {
      "type": "number",
      "label": "Strong turn from marks",
      "description": "Number of marks in a Cricket turn from which the strong-turn effect fires",
      "default": 6,
      "min": 3,
      "max": 9
    }
  },
  "effects": [
    { "id": 0, "name": "Solid" },
    { "id": 1, "name": "Blink" },
    { "id": 2, "name": "Breathe" },
    { "id": 9, "name": "Rainbow" },
    { "id": 12, "name": "Fade" },
    { "id": 17, "name": "Twinkle" },
    { "id": 20, "name": "Sparkle" },
    { "id": 23, "name": "Strobe" },
    { "id": 43, "name": "Lightning" },
    { "id": 52, "name": "Fire 2012" },
    { "id": 53, "name": "Colorwaves" },
    { "id": 62, "name": "Meteor" },
    { "id": 65, "name": "Ripple" },
    { "id": 79, "name": "Heartbeat" },
    { "id": 80, "name": "Pacifica" },
    { "id": 82, "name": "Fireworks" },
    { "id": 83, "name": "Fireworks Starburst" },
    { "id": 84, "name": "Fireworks 1D" }
  ],
  "intents": {
    "actions": [
      {
        "type": "solidColor",
        "label": "Solid Color",
        "description": "Set all LEDs to a solid color",
        "configSchema": {
          "color": { "type": "color", "label": "Color", "default": "#ff0000" },
          "brightness": { "type": "number", "label": "Brightness", "default": 255, "min": 0, "max": 255 },
          "duration": { "type": "number", "label": "Duration (ms)", "description": "0 = permanent", "default": 0, "min": 0 }
        }
      },
      {
        "type": "effect",
        "label": "Play Effect",
        "description": "Play a WLED effect",
        "configSchema": {
          "effectId": { "type": "number", "label": "Effect ID", "default": 0, "min": 0 },
          "speed": { "type": "number", "label": "Speed", "default": 128, "min": 0, "max": 255 },
          "intensity": { "type": "number", "label": "Intensity", "default": 128, "min": 0, "max": 255 },
          "color": { "type": "color", "label": "Primary Color", "default": "#ff0000" },
          "duration": { "type": "number", "label": "Duration (ms)", "description": "0 = permanent", "default": 2000, "min": 0 }
        }
      },
      {
        "type": "preset",
        "label": "Activate Preset",
        "description": "Activate a saved WLED preset",
        "configSchema": {
          "presetId": { "type": "number", "label": "Preset ID", "default": 1, "min": 1 },
          "duration": { "type": "number", "label": "Duration (ms)", "description": "0 = permanent", "default": 0, "min": 0 }
        }
      },
      {
        "type": "flash",
        "label": "Flash Color",
        "description": "Flash a color briefly",
        "configSchema": {
          "color": { "type": "color", "label": "Color", "default": "#ffffff" },
          "duration": { "type": "number", "label": "Flash Duration (ms)", "default": 500, "min": 50, "max": 5000 },
          "count": { "type": "number", "label": "Flash Count", "default": 3, "min": 1, "max": 10 }
        }
      },
      {
        "type": "rainbow",
        "label": "Rainbow Celebration",
        "description": "Rainbow effect for celebrations",
        "configSchema": {
          "duration": { "type": "number", "label": "Duration (ms)", "default": 3000, "min": 500 },
          "speed": { "type": "number", "label": "Speed", "default": 200, "min": 0, "max": 255 }
        }
      },
      {
        "type": "off",
        "label": "Turn Off",
        "description": "Turn off all LEDs"
      }
    ],
    "defaultSubscriptions": []
  },
  "i18n": {
    "en": {
      "name": "WLED Lighting Controller",
      "description": "Controls WLED-based LED strips based on Autodarts game events. Flash colors on throws, show player colors, celebrate 180s, and more!",
      "config": {
        "wledHost": {
          "label": "WLED IP Address",
          "description": "The IP address or hostname of the WLED controller"
        },
        "wledPort": {
          "label": "WLED Port",
          "description": "HTTP port of the WLED controller"
        },
        "fadeTime": {
          "label": "Fade Time (ms)",
          "description": "Global transition time in milliseconds. Empty = WLED default, 0 = instant"
        },
        "cricketMarksThreshold": {
          "label": "Strong turn from marks",
          "description": "Number of marks in a Cricket turn from which the strong-turn effect fires"
        }
      },
      "strings": {
        "connectionSuccess": "Successfully connected to WLED!",
        "connectionFailed": "Failed to connect to WLED",
        "testConnection": "Test Connection",
        "eventActions": "Event Actions",
        "playerColors": "Player Colors"
      }
    },
    "de": {
      "name": "WLED Lichtsteuerung",
      "description": "Steuert WLED-basierte LED-Streifen basierend auf Autodarts-Spielereignissen. Blitze bei Würfen, Spielerfarben, 180er-Feier und mehr!",
      "config": {
        "wledHost": {
          "label": "WLED IP-Adresse",
          "description": "Die IP-Adresse oder Hostname des WLED Controllers"
        },
        "wledPort": {
          "label": "WLED Port",
          "description": "HTTP Port des WLED Controllers"
        },
        "fadeTime": {
          "label": "Übergangszeit (ms)",
          "description": "Globale Übergangszeit in Millisekunden. Leer = WLED-Standard, 0 = sofort"
        },
        "cricketMarksThreshold": {
          "label": "Starke Aufnahme ab Marks",
          "description": "Anzahl Marks in einer Cricket-Aufnahme, ab der der Starke-Aufnahme-Effekt ausgelöst wird"
        }
      },
      "strings": {
        "connectionSuccess": "Erfolgreich mit WLED verbunden!",
        "connectionFailed": "Verbindung zu WLED fehlgeschlagen",
        "testConnection": "Verbindung testen",
        "eventActions": "Ereignis-Aktionen",
        "playerColors": "Spielerfarben"
      }
    },
    "es": {
      "name": "Control de Iluminación WLED",
      "description": "Controla tiras LED basadas en WLED según los eventos del juego Autodarts. Destella colores en los tiros, muestra colores de jugadores, celebra los 180 y más!",
      "config": {
        "wledHost": {
          "label": "Dirección IP de WLED",
