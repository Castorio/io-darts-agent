# IO-Darts-Agent Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Autodarts API Credentials (REQUIRED)
# ===================
# These are the OAuth2 client credentials for the Autodarts API
# You can get these from the Autodarts developer portal
AUTODARTS_CLIENT_ID=your-client-id
AUTODARTS_CLIENT_SECRET=your-client-secret

# ===================
# User Credentials (for testing only)
# ===================
# These can also be set via the web UI
# AUTODARTS_EMAIL=your-email@example.com
# AUTODARTS_PASSWORD=your-password
# AUTODARTS_BOARD_ID=your-board-id

# ===================
# Server Settings (optional)
# ===================
# SERVER_PORT=3000
# SERVER_HOST=0.0.0.0
