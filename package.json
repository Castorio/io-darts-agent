{
  "name": "io-darts-agent",
  "version": "1.0.1-beta",
  "description": "Modular Agent for Autodarts with WebSocket connection and module system",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src modules/wled/src modules/darts-caller/src modules/game-display/src --ext .ts",
    "lint:fix": "eslint src modules/wled/src modules/darts-caller/src modules/game-display/src --ext .ts --fix",
    "setup": "npm ci && npm run setup:sub",
    "setup:sub": "npm --prefix module-sdk ci && npm --prefix module-sdk run build && npm --prefix modules/wled ci && npm --prefix modules/darts-caller ci && npm --prefix web ci && npm --prefix modules/game-display/web ci",
    "build:app": "npm run clean:build && npm run build && npm run build:frontend && npm run build:modules",
    "prebuild:dist": "npm run build:app",
    "build:frontend": "cd web && npm run build",
    "build:modules": "npm --prefix modules/game-display/web run build",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "electron:build": "npm run prebuild:dist && electron-builder",
    "electron:build:win": "npm run prebuild:dist && electron-builder --win",
    "electron:build:mac": "npm run prebuild:dist && electron-builder --mac",
    "electron:build:linux": "npm run prebuild:dist && electron-builder --linux",
    "electron:build:all": "npm run prebuild:dist && electron-builder --win --mac --linux",
    "dist": "npm run electron:build",
    "dist:win": "npm run electron:build:win",
    "dist:mac": "npm run electron:build:mac",
    "dist:linux": "npm run electron:build:linux",
    "dist:all": "npm run electron:build:all",
    "clean:build": "node -e \"for (const d of ['dist/src','dist/modules']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "keywords": [
    "autodarts",
    "darts",
    "websocket",
    "hub"
  ],
  "author": "castor.io / Christoph Castor",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.56.0",
    "playwright": "^1.58.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.1",
    "@fastify/websocket": "^10.0.1",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "extract-zip": "^2.0.1",
    "fastify": "^4.26.0",
    "pino-pretty": "^13.2.0",
    "play-sound": "^1.1.6",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Castorio/io-darts-agent.git"
  },
  "homepage": "https://github.com/Castorio/io-darts-agent#readme",
  "bugs": {
    "url": "https://github.com/Castorio/io-darts-agent/issues"
  }
}
