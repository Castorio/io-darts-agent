{
  "id": "darts-caller",
  "name": "Darts Caller",
  "version": "1.1.0",
  "description": "Professional darts caller that announces scores, checkouts, and game events using text-to-speech or pre-recorded audio files.",
  "author": "IO-Darts-Agent Team",
  "entry": "dist/index.js",
  "events": [
    "match.start",
    "match.finished",
    "match.delete",
    "throw.detected",
    "player.change",
    "turn.finished",
    "game.finished"
  ],
  "intents": {
    "actions": [
      {
        "type": "playPhrase",
        "label": "Play Phrase",
        "description": "Play a pre-defined phrase from the voice pack",
        "configSchema": {
          "phrase": {
            "type": "select",
            "label": "Phrase",
            "options": [
              { "value": "oneEighty", "label": "One Hundred and Eighty!" },
              { "value": "oneSeventyOne", "label": "One Seventy One!" },
              { "value": "gameShot", "label": "Game Shot!" },
              { "value": "matchShot", "label": "Match Shot!" },
              { "value": "bust", "label": "Bust!" },
              { "value": "noScore", "label": "No Score" },
              { "value": "gameOn", "label": "Game On!" },
              { "value": "matchOn", "label": "Match On!" }
            ],
            "default": "oneEighty"
          }
        }
      },
      {
        "type": "sayText",
        "label": "Say Text",
        "description": "Speak custom text using TTS",
        "configSchema": {
          "text": { "type": "string", "label": "Text to speak", "default": "" }
        }
      },
      {
        "type": "playScore",
        "label": "Play Score",
        "description": "Announce a score from the intent payload",
        "configSchema": {
          "field": { "type": "string", "label": "Payload field", "default": "score" }
        }
      },
      {
        "type": "playFile",
        "label": "Play Audio File",
        "description": "Play a specific audio file",
        "configSchema": {
          "file": { "type": "string", "label": "File path", "default": "" }
        }
      }
    ],
    "defaultSubscriptions": []
  },
  "config": {
    "enabled": {
      "type": "boolean",
      "label": "Enable Caller",
      "description": "Enable or disable the darts caller",
      "default": true
    },
    "callerType": {
      "type": "select",
      "label": "Caller Type",
      "description": "Choose the audio source for voice calls",
      "default": "tts",
      "options": [
        { "value": "tts", "label": "Browser TTS" },
        { "value": "voicepack", "label": "AI Voice Pack" },
        { "value": "elevenlabs", "label": "ElevenLabs Live AI" },
        { "value": "audio", "label": "Custom Audio Files" }
      ]
    },
    "language": {
      "type": "select",
      "label": "Language",
      "description": "Language for voice output",
      "default": "en",
      "options": [
        { "value": "en", "label": "English" },
        { "value": "de", "label": "Deutsch" }
      ]
    },
    "volume": {
      "type": "number",
      "label": "Volume",
      "description": "Audio volume (0 - 100)",
      "default": 80,
      "min": 0,
      "max": 100
    },
    "delayMs": {
      "type": "number",
      "label": "Delay (ms)",
      "description": "Delay before announcing (milliseconds)",
      "default": 200,
      "min": 0,
      "max": 2000
    },
    "ttsSettings": {
      "type": "group",
      "label": "Browser TTS Settings",
      "description": "Settings for browser text-to-speech",
      "showIf": { "field": "callerType", "value": "tts" },
      "fields": {
        "voice": {
          "type": "string",
          "label": "Voice",
          "description": "Voice identifier (browser dependent)",
          "default": ""
        },
        "rate": {
          "type": "number",
          "label": "Speed",
          "description": "Speech rate (0.5 - 2.0)",
          "default": 1.0,
          "min": 0.5,
          "max": 2.0,
          "step": 0.1
        },
        "pitch": {
          "type": "number",
          "label": "Pitch",
          "description": "Voice pitch (0.5 - 2.0)",
          "default": 1.0,
          "min": 0.5,
          "max": 2.0,
          "step": 0.1
        }
      }
    },
    "voicepackSettings": {
      "type": "group",
      "label": "Voice Pack Settings",
      "description": "Settings for AI-generated voice packs",
      "showIf": { "field": "callerType", "value": "voicepack" },
      "fields": {
        "packId": {
          "type": "string",
          "label": "Voice Pack",
          "description": "Select a generated voice pack to use",
          "default": ""
        }
      }
    },
    "elevenlabsSettings": {
      "type": "group",
      "label": "ElevenLabs Settings",
      "description": "Settings for ElevenLabs live AI voice",
      "showIf": { "field": "callerType", "value": "elevenlabs" },
      "fields": {
        "voiceId": {
          "type": "string",
          "label": "Voice ID",
          "description": "Voice ID from ElevenLabs",
          "default": ""
        },
        "stability": {
          "type": "number",
          "label": "Stability",
          "description": "Voice stability (0.0 - 1.0)",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "similarity": {
          "type": "number",
          "label": "Similarity Boost",
          "description": "Similarity boost (0.0 - 1.0)",
          "default": 0.75,
          "min": 0,
          "max": 1,
          "step": 0.05
        }
      }
    },
    "audioSettings": {
      "type": "group",
      "label": "Custom Audio Settings",
      "description": "Settings for custom audio files",
      "showIf": { "field": "callerType", "value": "audio" },
      "fields": {
        "packPath": {
          "type": "string",
          "label": "Audio Pack Path",
          "description": "Path to custom audio pack folder (relative to media directory)",
          "default": ""
        }
      }
    },
    "callSettings": {
      "type": "group",
      "label": "Call Settings",
      "description": "Configure what to announce",
      "fields": {
        "scores": {
          "type": "boolean",
          "label": "Call Scores",
          "description": "Announce thrown scores",
          "default": true
        },
        "highScoresOnly": {
          "type": "boolean",
          "label": "High Scores Only",
          "description": "Only call scores of 100 or higher",
          "default": false
        },
        "checkouts": {
          "type": "boolean",
          "label": "Call Checkouts",
          "description": "Announce checkout opportunities",
          "default": true
        },
        "playerChange": {
          "type": "boolean",
          "label": "Call Player Change",
          "description": "Announce when player changes",
          "default": true
        },
        "gameStart": {
          "type": "boolean",
          "label": "Call Game Start",
          "description": "Announce match and game start",
          "default": true
        },
        "gameOver": {
          "type": "boolean",
          "label": "Call Game Over",
          "description": "Announce match and game end",
          "default": true
        },
        "special180": {
          "type": "boolean",
          "label": "Special 180 Call",
          "description": "Special announcement for 180",
          "default": true
        },
        "busts": {
          "type": "boolean",
          "label": "Call Busts",
          "description": "Announce when player busts",
          "default": true
        }
      }
    }
  },
