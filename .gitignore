# ===================
# IO-Darts-Agent
# ===================

# Dependencies
node_modules/
modules_installed/
.pnp/
.pnp.js

# Build outputs
dist/
releases/
*.tsbuildinfo

# Compiled TypeScript output (should only be in dist/)
modules/*/src/*.js
modules/*/src/*.js.map
modules/*/src/*.d.ts
modules/*/src/*.d.ts.map
modules/*/src/types/*.js
modules/*/src/types/*.d.ts
src/types/*.js
src/types/*.js.map
src/types/*.d.ts
src/types/*.d.ts.map

# Electron builds
*.dmg
*.exe
*.AppImage
*.deb
*.rpm
*.snap
*.blockmap
*.zip

# Test outputs
coverage/
.nyc_output/
test-results/
playwright-report/
playwright-user-data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===================
# SECRETS & CONFIG
# ===================

# Config files with credentials - NEVER COMMIT!
config/hub.config.json
config/*.config.json
config/ai-providers.json
!config/*.example.json

# Environment files
.env
.env.local
.env.development
.env.production
.env*.local

# Autodarts credentials
credentials.json
auth.json
tokens.json

# ===================
# IDE & OS
# ===================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Claude Code / Claw
.claudeclaw.json
.claude/

# Vim
*.swp
*.swo
*~

# ===================
# Media & Voice Packs
# ===================

# Media files (animations, sounds, images)
media/animation/*
media/sound/*
media/image/*
!media/animation/.gitkeep
!media/sound/.gitkeep
!media/image/.gitkeep

# Voice packs and TTS cache
data/voicepacks/*
data/tts-cache/*
!data/voicepacks/.gitkeep
!data/tts-cache/.gitkeep

# Common media formats
*.mp3
*.wav
*.ogg
*.flac
*.aac
*.m4a
*.mp4
*.webm
*.gif
*.png
*.jpg
*.jpeg
*.webp
*.svg
*.ico

# ===================
# Misc
# ===================

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Local development
*.local

# Debug
.debug/

# pkg cache
.pkg-cache/

# Compiled test output
test/**/*.js
test/**/*.js.map
test/**/*.d.ts
test/**/*.d.ts.map
