{
  "id": "game-display",
  "name": "Game Display",
  "version": "1.4.0",
  "description": "Displays the current game score on a separate display. Perfect for large screens next to the dartboard.",
  "author": "IO-Darts-Agent Team",
  "entry": "internal",
  "events": [
    "match.start",
    "match.delete",
    "match.finish",
    "match.finished",
    "match.result",
    "match.state",
    "throw.detected",
    "player.change",
    "turn.finished",
    "game.finished"
  ],
  "intents": {
    "actions": [
      {
        "type": "showAnimation",
        "label": "Show Animation",
        "description": "Display a custom animation overlay",
        "configSchema": {
          "animationType": {
            "type": "select",
            "label": "Animation Type",
            "options": [
              { "value": "celebration", "label": "Celebration" },
              { "value": "alert", "label": "Alert" },
              { "value": "custom", "label": "Custom Media" }
            ],
            "default": "celebration"
          },
          "mediaUrl": {
            "type": "string",
            "label": "Media URL",
            "description": "URL to GIF or video (for custom type)",
            "default": ""
          },
          "duration": {
            "type": "number",
            "label": "Duration (ms)",
            "default": 3000,
            "min": 500,
            "max": 10000
          }
        }
      },
      {
        "type": "showMessage",
        "label": "Show Message",
        "description": "Display a text message overlay",
        "configSchema": {
          "message": {
            "type": "string",
            "label": "Message",
            "default": ""
          },
          "style": {
            "type": "select",
            "label": "Style",
            "options": [
              { "value": "success", "label": "Success (Green)" },
              { "value": "info", "label": "Info (Blue)" },
              { "value": "warning", "label": "Warning (Yellow)" },
              { "value": "error", "label": "Error (Red)" }
            ],
            "default": "info"
          },
          "duration": {
            "type": "number",
            "label": "Duration (ms)",
            "default": 3000,
            "min": 1000,
            "max": 10000
          }
        }
      },
      {
        "type": "playSound",
        "label": "Play Sound",
        "description": "Play a sound effect",
        "configSchema": {
          "soundUrl": {
            "type": "string",
            "label": "Sound URL",
            "description": "URL to audio file (MP3, WAV)",
            "default": ""
          }
        }
      }
    ],
    "defaultSubscriptions": []
  },
  "config": {
    "displayName": {
      "type": "string",
      "label": "Display Name",
      "description": "Name of this display (for multiple displays)",
      "default": "Main Display"
    },
    "idleMode": {
      "type": "select",
      "label": "Idle Mode",
      "description": "What to show when no game is active",
      "default": "lastGame",
      "options": [
        { "value": "black", "label": "Black Screen" },
        { "value": "image", "label": "Custom Image" },
        { "value": "lastGame", "label": "Show Last Game Score" }
      ]
    },
    "idleImageUrl": {
      "type": "string",
      "label": "Idle Image URL",
      "description": "URL to the image shown in idle mode (only for 'Custom Image')",
      "default": "",
      "showIf": { "field": "idleMode", "value": "image" }
    },
    "matchStartedMode": {
      "type": "select",
      "label": "Match Started Mode",
      "description": "What to show when a match has started but no throws have been made yet",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default (Game On! screen)" },
        { "value": "image", "label": "Custom Image/GIF" }
      ]
    },
    "matchStartedImageUrl": {
      "type": "string",
      "label": "Match Started Image URL",
      "description": "URL to image or GIF shown when match starts",
      "default": "",
      "showIf": { "field": "matchStartedMode", "value": "image" }
    },
    "matchStartedDuration": {
      "type": "number",
      "label": "Match Started Duration (ms)",
      "description": "How long the match started screen is shown before showing the game",
      "default": 3000,
      "min": 1000,
      "max": 10000
    },
    "gameOnBackgroundColor": {
      "type": "color",
      "label": "Game On Background Color",
      "description": "Background color of the Game On! screen",
      "default": "#0a0a0f",
      "showIf": { "field": "matchStartedMode", "value": "default" }
    },
    "matchResultsDuration": {
      "type": "number",
      "label": "Match Results Display Duration (ms)",
      "description": "How long to show the results table after a match ends (0 = until dismissed manually)",
      "default": 30000,
      "min": 0,
      "max": 120000
    },
    "matchResultsBackgroundColor": {
      "type": "color",
      "label": "Match Results Background Color",
      "description": "Background color of the results table",
      "default": "#0a0a0f"
    },
    "showCheckouts": {
      "type": "boolean",
      "label": "Show Checkout Suggestions",
      "description": "Shows possible checkout paths",
      "default": true
    },
    "checkoutThreshold": {
      "type": "number",
      "label": "Checkout From Score",
      "description": "From which score checkout suggestions are shown",
      "default": 170,
      "min": 2,
      "max": 170
    },
    "showOtherPlayers": {
      "type": "boolean",
      "label": "Show Other Players",
      "description": "Shows other players at the bottom",
      "default": true
    },
    "animationsEnabled": {
      "type": "boolean",
      "label": "Enable Animations",
      "description": "Show animations for special events (180, bulls, wins)",
      "default": true
    },
    "defaultAnimationDuration": {
      "type": "number",
      "label": "Default Animation Duration (ms)",
      "description": "Default display duration for animations",
      "default": 3000,
      "min": 500,
      "max": 10000
    },
    "animation180": {
      "type": "group",
      "label": "180 Animation",
      "description": "Animation for 180 scores",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "description": "URL to GIF or video",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "description": "URL to sound file (MP3, WAV)",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 4000,
          "min": 1000,
          "max": 10000
        }
      }
    },
    "animationBull": {
      "type": "group",
      "label": "Bull Animation",
      "description": "Animation for single bulls (25)",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 2000,
          "min": 500,
          "max": 5000
        }
      }
    },
    "animationDoubleBull": {
      "type": "group",
      "label": "Double Bull Animation",
      "description": "Animation for double bulls (50)",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 2500,
          "min": 500,
          "max": 5000
        }
      }
    },
    "animationHighScore": {
      "type": "group",
      "label": "High Score Animation",
      "description": "Animation for high scores",
      "showIf": { "field": "animationsEnabled", "value": true },
      "fields": {
        "type": {
          "type": "select",
          "label": "Type",
          "default": "builtin",
          "options": [
            { "value": "none", "label": "Disabled" },
            { "value": "builtin", "label": "Built-in" },
            { "value": "gif", "label": "GIF" },
            { "value": "video", "label": "Video" }
          ]
        },
        "threshold": {
          "type": "number",
          "label": "From Score",
          "default": 140,
          "min": 100,
          "max": 179
        },
        "mediaUrl": {
          "type": "string",
          "label": "Media URL",
          "default": ""
        },
        "soundUrl": {
          "type": "string",
          "label": "Sound URL",
          "default": ""
        },
        "duration": {
          "type": "number",
          "label": "Duration (ms)",
          "default": 2000,
          "min": 500,
          "max": 5000
        }
      }
    },
    "animationCheckout": {
