                { "value": "video", "label": "Video" }
              ]
            },
            "url": {
              "type": "string",
              "label": "Media URL",
              "default": ""
            },
            "sound": {
              "type": "boolean",
              "label": "Play Sound",
              "default": false
            },
            "soundUrl": {
              "type": "string",
              "label": "Sound URL",
              "default": ""
            },
            "duration": {
              "type": "number",
              "label": "Duration (ms)",
              "default": 1500,
              "min": 500,
              "max": 3000
            }
          }
        }
      }
    },
    "playerAnimations": {
      "type": "array",
      "label": "Player-specific Animations",
      "description": "Individual animations per player (overrides global settings)",
      "itemType": "object",
      "itemFields": {
        "playerId": {
          "type": "string",
          "label": "Player ID",
          "description": "ID of the local player"
        },
        "playerName": {
          "type": "string",
          "label": "Player Name",
          "description": "Name for easier identification"
        },
        "throw180": {
          "type": "object",
          "label": "180 Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Enabled",
              "default": true
            },
            "type": {
              "type": "select",
              "label": "Animation Type",
