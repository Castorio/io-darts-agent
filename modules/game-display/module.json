          "label": "Bust Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Aktiviert",
              "default": true
            },
            "type": {
              "type": "select",
              "label": "Animationstyp",
              "default": "builtin",
              "options": [
                { "value": "builtin", "label": "Eingebaut" },
                { "value": "gif", "label": "GIF" },
                { "value": "video", "label": "Video" }
              ]
            },
            "url": {
              "type": "string",
              "label": "Medien-URL",
              "default": ""
            },
            "sound": {
              "type": "boolean",
              "label": "Sound abspielen",
              "default": false
            },
            "soundUrl": {
              "type": "string",
              "label": "Sound-URL",
              "default": ""
            },
            "duration": {
              "type": "number",
              "label": "Dauer (ms)",
              "default": 1500,
              "min": 500,
              "max": 3000
            }
          }
        }
      }
    },
    "playerAnimations": {
      "type": "array",
      "label": "Spieler-spezifische Animationen",
      "description": "Individuelle Animationen pro Spieler (überschreibt globale Einstellungen)",
      "itemType": "object",
      "itemFields": {
        "playerId": {
          "type": "string",
          "label": "Spieler-ID",
          "description": "ID des lokalen Spielers"
        },
        "playerName": {
          "type": "string",
          "label": "Spieler-Name",
          "description": "Name zur einfacheren Identifikation"
        },
        "throw180": {
          "type": "object",
          "label": "180 Animation",
          "fields": {
            "enabled": {
              "type": "boolean",
              "label": "Aktiviert",
              "default": true
            },
            "type": {
              "type": "select",
              "label": "Animationstyp",
              "default": "builtin",
              "options": [
                { "value": "builtin", "label": "Eingebaut" },
